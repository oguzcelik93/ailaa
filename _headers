# Ailaa — sunucu başlıkları

# ── Relia: sitede barındırılan uygulama ──
# Çerçeve engelleyen başlıklar kaldırılır
/relia/*
  ! X-Frame-Options
  ! Content-Security-Policy

# HTML asla önbelleğe yapışmasın — güncelleme anında görünsün
/relia/*.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, must-revalidate

# Klasör kökü (/relia/ → index.html) için de aynı kural
/relia/
  Cache-Control: no-cache, must-revalidate

# Service worker: doğru tür, önbelleksiz, kapsam klasörle sınırlı
/relia/sw.js
  Content-Type: text/javascript; charset=utf-8
  Service-Worker-Allowed: /relia/
  Cache-Control: no-cache, must-revalidate

/relia/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache

/relia/logo.svg
  Content-Type: image/svg+xml; charset=utf-8

# Görseller normal önbelleklenebilir
/relia/*.png
  Cache-Control: public, max-age=604800
